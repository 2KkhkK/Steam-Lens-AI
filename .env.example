# -----------------------------------------------------------------------------
# Steam Lens AI 환경변수 템플릿
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# .env는 .gitignore에 등록되어 있으므로 절대 커밋되지 않는다.
# 이 파일(.env.example)에는 "어떤 키가 필요한지"만 적고 실제 값은 넣지 않는다.
# -----------------------------------------------------------------------------

# --- Django 코어 -------------------------------------------------------------
# 운영(DJANGO_DEBUG=False)에서는 반드시 필요하다. 없거나 약하면(50자 미만,
# django-insecure- 접두사) 서버가 부팅을 거부한다.
# 로컬 개발(DJANGO_DEBUG=True)에서는 비워 두면 실행마다 임시 키가 생성된다.
# 생성:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 로컬 개발용 기본값. 배포 시 반드시 False로 바꾼다(또는 줄을 지운다 - 기본값이 False).
DJANGO_DEBUG=True

# 쉼표로 구분. 배포 시 실제 도메인으로 교체.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- HTTPS (운영) ---------------------------------------------------------------
# DJANGO_DEBUG=False이면 SSL 리다이렉트 / 보안 쿠키 / HSTS가 '자동으로' 켜진다.
# 여기에 False를 적어 두면 운영으로 옮길 때 그대로 꺼진 채 배포되므로
# 기본은 주석으로 둔다. HTTPS 없이 DEBUG=False를 시험할 때만 잠깐 켠다.
# DJANGO_SECURE_SSL=False

# HSTS 유지 시간(초). 브라우저에 한 번 저장되면 되돌리기 어려우므로 처음엔 짧게
# 시작해 HTTPS가 정상인지 확인한 뒤 31536000(1년)으로 늘린다.
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_PRELOAD=False

# nginx / 로드밸런서 뒤에서 TLS를 종료한다면 True.
# 프록시가 없는데 켜면 클라이언트가 X-Forwarded-* 헤더를 위조할 수 있다.
# DJANGO_BEHIND_PROXY=False

# 다른 출처에서 POST를 받아야 할 때. 예) https://steamlens.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- 관리자 페이지 ----------------------------------------------------------------
# 기본값(steamlens-admin)은 공개 저장소에 적혀 있으므로 운영에서는 바꾼다.
# DJANGO_ADMIN_URL=steamlens-admin

# --- 요청 제한 ------------------------------------------------------------------
# 형식: 횟수/기간 (s, m, h, d / 예: 5/15m)
# 카운터는 캐시에 저장되므로 워커가 여럿이면 REDIS_URL을 지정해야 정확하다.
# RATE_LIMIT_ENABLED=True
# RATE_LIMIT_SEARCH=30/m
# RATE_LIMIT_CLICK=60/m
# RATE_LIMIT_DASHBOARD=10/m
# RATE_LIMIT_ADMIN_LOGIN=5/15m
# MAX_QUERY_LENGTH=100

# --- 외부 API 키 --------------------------------------------------------------
# Steam Web API 키: https://steamcommunity.com/dev/apikey
# 없으면 로그인/보유게임 기능만 동작하지 않고 검색 추천은 정상 동작한다.
STEAM_API_KEY=

# IsThereAnyDeal API 키: https://isthereanydeal.com/apps/my/
# 비워 두면 mock_lowest_price.json의 샘플 데이터로 자동 대체된다.
# (예전에 소스에 하드코딩됐던 키는 폐기됨. 절대 재사용하지 말 것)
ITAD_API_KEY=

# --- 인프라 -------------------------------------------------------------------
# 비워 두면 프로세스 로컬 메모리 캐시를 쓴다.
# 워커를 여러 개 띄울 때는 반드시 Redis를 지정해야 캐시가 공유된다.
# 예) redis://127.0.0.1:6379/1
REDIS_URL=

LOG_LEVEL=INFO

# --- 추천 엔진 튜닝 -----------------------------------------------------------
# bulk_evaluate.py --grid 로 찾은 최적값을 여기에 옮겨 적는다.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CANDIDATE_POOL=1000
TOP_N=6
SEARCH_TAG_WEIGHT=3.0
DASHBOARD_TAG_WEIGHT=5.0
DASHBOARD_META_WEIGHT=2.0
WEIGHTED_TAGS=True
PROFILE_GAMES=10
ENRICH_WORKERS=6

# 결과 설명문 한국어 번역 사용 여부. False면 원문(영어)을 그대로 보여준다.
TRANSLATE=True
