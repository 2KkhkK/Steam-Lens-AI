# -----------------------------------------------------------------------------
# Steam Lens AI 환경변수 템플릿
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# .env는 .gitignore에 등록되어 있으므로 절대 커밋되지 않는다.
# 이 파일(.env.example)에는 "어떤 키가 필요한지"만 적고 실제 값은 넣지 않는다.
# -----------------------------------------------------------------------------

# --- Django 코어 -------------------------------------------------------------
# 비워 두면 실행할 때마다 임시 키가 생성된다(로컬 개발용).
# 실제 값 생성:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 로컬 개발 중 상세 에러 페이지를 보고 싶을 때만 True. 배포 시 반드시 False.
DJANGO_DEBUG=True

# 쉼표로 구분. 배포 시 실제 도메인으로 교체.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS로 배포할 때만 True (HSTS, 보안 쿠키, SSL 리다이렉트가 켜진다).
DJANGO_SECURE_SSL=False

# --- 외부 API 키 --------------------------------------------------------------
# Steam Web API 키: https://steamcommunity.com/dev/apikey
# 없으면 로그인/보유게임 기능만 동작하지 않고 검색 추천은 정상 동작한다.
STEAM_API_KEY=

# IsThereAnyDeal API 키: https://isthereanydeal.com/apps/my/
# 없으면 mock_lowest_price.json의 샘플 데이터로 자동 대체된다.
ITAD_API_KEY=

# --- 인프라 -------------------------------------------------------------------
# 비워 두면 프로세스 로컬 메모리 캐시를 쓴다.
# 워커를 여러 개 띄울 때는 반드시 Redis를 지정해야 캐시가 공유된다.
# 예) redis://127.0.0.1:6379/1
REDIS_URL=

LOG_LEVEL=INFO

# --- 추천 엔진 튜닝 -----------------------------------------------------------
# bulk_evaluate.py --grid 로 찾은 최적값을 여기에 옮겨 적는다.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CANDIDATE_POOL=1000
TOP_N=6
SEARCH_TAG_WEIGHT=3.0
DASHBOARD_TAG_WEIGHT=5.0
DASHBOARD_META_WEIGHT=2.0
WEIGHTED_TAGS=True
PROFILE_GAMES=10
ENRICH_WORKERS=6

# 결과 설명문 한국어 번역 사용 여부. False면 원문(영어)을 그대로 보여준다.
TRANSLATE=True
